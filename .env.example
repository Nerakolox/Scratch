# ---- App ----
# Public base URL of the deployment. Must match the OAuth redirect URIs exactly.
VITE_APP_URL=http://localhost:5173

# ---- tldraw (Canvas engine) ----
# tldraw requires a valid licence for production builds. Leave empty during
# development; production without a licence is NOT a deployable configuration.
# Free options: 100-day trial (one per commercial unit) and a non-commercial
# hobby licence with a required watermark. See https://tldraw.dev/pricing
VITE_TLDRAW_LICENSE_KEY=

# ---- Microsoft OneDrive (BYOS backup) ----
# Register an SPA app in Microsoft Entra admin center, add a *Single-page
# application* redirect URI: <VITE_APP_URL> (OAuth popup returns to the app).
# Permission: delegated Files.ReadWrite.AppFolder. Never add a client secret.
VITE_ONEDRIVE_CLIENT_ID=
VITE_ONEDRIVE_TENANT=consumers
VITE_ONEDRIVE_REDIRECT_URI=

# ---- Google Drive (BYOS backup) ----
# Google Cloud Console → OAuth client ID (Web application), authorised
# JavaScript origin <origin of VITE_APP_URL>. Scope: drive.appdata.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=

# ---- Generic ----
# Maximum size of a single imported backup archive (bytes).
VITE_MAX_BACKUP_BYTES=268435456
